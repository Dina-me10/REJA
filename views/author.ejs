<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/main.css" />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
      rel="stylesheet"
    />
    <script src="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/js/bootstrap.min.js"></script>
    <title>Portfolio</title>
  </head>

  <body>
    <div class="frame">
<div class="main_frame">
    <div class="left_frame">
      <div class="profile_container">
    <div class="profile_img_box">
        <img src="/author/images/Profile.png" alt="<%= user.name %>">
        <div class="status_indicator"></div>
    </div>

    <div class="profile_name"><%= user.name %></div>

    <div class="profile_job"><%= user.profession %></div>

    <div class="social_icons_row">
        <div class="social_icon"><i class="fa fa-facebook"></i></div>
        <div class="social_icon"><i class="fa fa-instagram"></i></div>
        <div class="social_icon"><i class="fa fa-twitter"></i></div>
        <div class="social_icon"><i class="fa fa-linkedin"></i></div>
        <div class="social_icon"><i class="fa fa-youtube"></i></div>
        <div class="social_icon"><i class="fa fa-dribbble"></i></div>
    </div>
</div>
<div class="line_6"></div>
<div class="about_container">
    <div class="about_row">
        <div class="about_label">Age:</div>
        <div class="about_value"><%= user.age %></div>
    </div>

    <div class="about_row">
        <div class="about_label">Residence:</div>
        <div class="about_value"><%= user.residence %></div>
    </div>

    <div class="about_row">
        <div class="about_label">Freelance:</div>
        <div class="about_value status_available">Available</div>
    </div>

    <div class="about_row">
        <div class="about_label">Address:</div>
        <div class="about_value"><%= user.adress %></div>
    </div>
</div>

<div class="line_3"></div>
<div class="languages_container">
    <div class="languages_title">Languages</div>
    
    <div class="lang_item">
        <div class="lang_info">
            <span class="lang_name">Uzbek</span>
            <span class="lang_percent">100%</span>
        </div>
        <div class="lang_bar_wrapper">
            <div class="lang_bar_fill" style="width: 100%;"></div>
        </div>
    </div>

    <div class="lang_item">
        <div class="lang_info">
            <span class="lang_name">Korean</span>
            <span class="lang_percent">60%</span>
        </div>
        <div class="lang_bar_wrapper">
            <div class="lang_bar_fill" style="width: 100%;"></div>
        </div>
    </div>

    <div class="lang_item">
        <div class="lang_info">
            <span class="lang_name">English</span>
            <span class="lang_percent">90%</span>
        </div>
        <div class="lang_bar_wrapper">
            <div class="lang_bar_fill" style="width: 100%;"></div>
        </div>
    </div>
</div>

<div class="line_4"></div>
<div class="skills_container">
    <div class="skills_title">Skills</div>
    
    <div class="skill_item">
        <div class="skill_info">
            <span class="skill_name">Html</span>
            <span class="skill_percent">90%</span>
        </div>
        <div class="skill_bar_wrapper">
            <div class="skill_bar_fill" style="width: 90%;"></div>
        </div>
    </div>

    <div class="skill_item">
        <div class="skill_info">
            <span class="skill_name">Css</span>
            <span class="skill_percent">85%</span>
        </div>
        <div class="skill_bar_wrapper">
            <div class="skill_bar_fill" style="width: 85%;"></div>
        </div>
    </div>

    <div class="skill_item">
        <div class="skill_info">
            <span class="skill_name">Js</span>
            <span class="skill_percent">80%</span>
        </div>
        <div class="skill_bar_wrapper">
            <div class="skill_bar_fill" style="width: 80%;"></div>
        </div>
    </div>

    <div class="skill_item">
        <div class="skill_info">
            <span class="skill_name">NodeJS</span>
            <span class="skill_percent">75%</span>
        </div>
        <div class="skill_bar_wrapper">
            <div class="skill_bar_fill" style="width: 75%;"></div>
        </div>
    </div>

    <div class="skill_item">
        <div class="skill_info">
            <span class="skill_name">Python</span>
            <span class="skill_percent">85%</span>
        </div>
        <div class="skill_bar_wrapper">
            <div class="skill_bar_fill" style="width: 70%;"></div>
        </div>
    </div>
</div>

<div class="line_5"></div>
<div class="extra_skills_container">
    <div class="extra_skills_title">Extra Skills</div>

    <div class="extra_skill_item">
        <img src="/author/images/icon/Icons.png" alt="icon" class="extra_icon">
        <span class="extra_skill_text">Bootstrap, Materialize</span>
    </div>

    <div class="extra_skill_item">
       <img src="/author/images/icon/Icons.png" alt="icon" class="extra_icon">
        <span class="extra_skill_text">Stylus, Sass, Less</span>
    </div>

    <div class="extra_skill_item">
       <img src="/author/images/icon/Icons.png" alt="icon" class="extra_icon">
        <span class="extra_skill_text">Gulp, Webpack, Grunt</span>
    </div>

    <div class="extra_skill_item">
       <img src="/author/images/icon/Icons.png" alt="icon" class="extra_icon">
        <span class="extra_skill_text">GIT Knowledge</span>
    </div>
</div>

<div class="line_6"></div>
        </div>

   <div class="middle_frame">
    <div class="main_menu_container">
        <div class="shape ellipse_12"></div>
        <div class="shape ellipse_16"></div>
        <div class="shape ellipse_13"></div>
        <div class="shape ellipse_15"></div>
        <div class="shape rect_51"></div>
        <div class="shape poly_1"></div>

        <div class="main_menu_container">
    <div class="hero_text_content">
        <h1 class="hero_main_title">SOFTWARE ENGINEER...</h1>
        <p class="hero_sub_paragraph">Software engineers design, develop, test, and maintain software applications and computer systems, combining analytical thinking and problem-solving skills to create technology solutions across industries
        </p>
        <button class="hire_me_button">HIRE ME...</button>
    </div>

    <div class="hero_person_img">
        <img src="/author/images/steve_large.png" class="steve_large">
    </div>
</div>
    </div>

    <section class="services_container">
        <div class="services_header">
            <h2 class="services_title">My Services</h2>
            <p class="services_subtitle">
                Amet minim mollit non deserunt ullamco est sit aliqua dolor do amet sint. 
                Velit officia consequat duis enim velit mollit. lorem ipsum
            </p>
        </div>

        <div class="services_grid">
            <div class="service_card">
                <img src="/author/images/icon/coding.png" alt="web" class="service_icon">
                <h4>Web Development</h4>
                <p>Blog, E-Commerce</p>
            </div>

            <div class="service_card">
                <img src="/author/images/icon/illustration.png" alt="uiux" class="service_icon">
                <h4>UI/UX Design</h4>
                <p>Mobile App, Website Design</p>
            </div>

            <div class="service_card">
                <img src="/author/images/icon/Microphone.png" alt="sound" class="service_icon">
                <h4>Sound Design</h4>
                <p>Voice Over, Beat Making</p>
            </div>

            <div class="service_card">
                <img src="/author/images/icon/game-development.png" alt="game" class="service_icon">
                <h4>Game Design</h4>
                <p>Character Design, Props & Objects</p>
            </div>

            <div class="service_card">
                <img src="/author/images/icon/Photographer.png" alt="photo" class="service_icon">
                <h4>Photography</h4>
                <p>Portrait, Product Photography</p>
            </div>

            <div class="service_card">
               
                <h4>Advertising</h4>
                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
                <a href="#" class="order_link">ORDER NOW ></a>
            </div>
        </div>
    </section>
</div>

    <div class="right_frame">
      <div class="right_frame">
    <div class="contrast_icon">
        <img src="/author/images/icon/Contrast.png" alt="theme">
    </div>

    <nav class="side_menu">
        <div class="nav_group active">
            <div class="tooltip">Home</div>
            <a href="#" class="nav_item circle_yellow">
                <img src="/author/images/icon/Home.png" alt="home">
            </a>
        </div>

        <div class="nav_group">
            <a href="#" class="nav_item circle_gray">
                <img src="/author/images/icon/service.png" alt="services">
            </a>
        </div>
        
        <div class="nav_group">
            <a href="#" class="nav_item circle_gray">
                <img src="/author/images/icon/cv.png" alt="cv">
            </a>
        </div>

        <div class="nav_group">
            <a href="#" class="nav_item circle_gray">
                <img src="/author/images/icon/Portfolio.png" alt="work">
            </a>
        </div>

        <div class="nav_group">
            <a href="#" class="nav_item circle_gray">
                <img src="/author/images/icon/Blog.png" alt="blog">
            </a>
        </div>

        <div class="nav_group">
            <a href="#" class="nav_item circle_gray">
                <img src="/author/images/icon/Contact.png" alt="contact">
            </a>
        </div>
    </nav>
</div>
        </div>
</div>
      </div>
    </div>
  </body>
</html>
