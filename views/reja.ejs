<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PLANS AND GOALS </title>
    <link
      rel="stylesheet"
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
    />
    <style>
  :root {
    --bg-gradient: linear-gradient(135deg, #fff0f3 0%, #ffdde1 100%);
    --primary-pink: #ff85a1;
    --dark-rose: #a4133c;
    --bright-green: #2ecc71; /* Ochirish */
    --bright-yellow: #fff200; /* Ozgartirish */
    --glass-white: rgba(255, 255, 255, 0.85);
  }

  body {
    background: var(--bg-gradient);
    min-height: 100vh;
    font-family: 'Segoe UI', Roboto, sans-serif;
    color: var(--dark-rose);
    overflow-x: hidden;
  }

  h1 {
    font-weight: 800;
    color: var(--dark-rose);
    text-shadow: 2px 2px 0px #ffccd5;
    text-align: center;
    margin-bottom: 30px;
  }

  .p-4.shadow-sm.bg-white {
    background: var(--glass-white) !important;
    backdrop-filter: blur(10px);
    border: 2px solid #ffccd5;
    border-radius: 25px !important;
  }

  /* --- BUTTON BASE --- */
  .btn {
    border-radius: 50px;
    font-weight: 700;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    border: none;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* ADD PLAN (Pink) */
  .btn-primary {
    background-color: var(--primary-pink);
    color: white;
  }
  .btn-primary:hover {
    background-color: #ff4d6d;
    transform: scale(1.05) translateY(-2px);
    box-shadow: 0 5px 15px rgba(255, 77, 109, 0.4);
  }

  /* OZGARTIRISH (Bright Yellow) */
  .edit-me {
    background-color: var(--bright-yellow) !important;
    color: #444 !important; /* Darker text for readability on yellow */
    box-shadow: 0 4px 10px rgba(255, 242, 0, 0.3);
  }
  .edit-me:hover {
    background-color: #fffa00 !important;
    transform: scale(1.1);
    box-shadow: 0 0 20px rgba(255, 242, 0, 0.7);
  }

  /* OCHIRISH (Bright Green) */
  .delete-me {
    background-color: var(--bright-green) !important;
    color: white !important;
    box-shadow: 0 4px 10px rgba(46, 204, 113, 0.3);
  }
  .delete-me:hover {
    background-color: #27ae60 !important;
    transform: scale(1.1);
    box-shadow: 0 0 20px rgba(46, 204, 113, 0.6);
  }

  /* CLEAN ALL */
  #clean-all {
    background: white;
    border: 2px solid var(--primary-pink);
    color: var(--primary-pink);
  }
  #clean-all:hover {
    background: var(--primary-pink);
    color: white;
    transform: translateY(-5px);
  }

  /* LIST ITEMS */
  .list-group-item-info {
    background: white !important;
    border: 2px solid #fff0f3 !important;
    color: var(--dark-rose) !important;
    border-radius: 20px !important;
    margin-bottom: 15px !important;
    box-shadow: 0 5px 10px rgba(0,0,0,0.02);
  }
  .list-group-item-info:hover {
    transform: translateX(10px);
    border-color: #ffccd5 !important;
  }

  /* --- PEARLS --- */
  .pearl {
    position: fixed;
    top: -30px;
    background: radial-gradient(circle at 30% 30%, #ffffff, #ffe5ec);
    border-radius: 50%;
    z-index: 1;
    pointer-events: none;
    animation: fall linear infinite;
    box-shadow: inset -2px -2px 5px rgba(0,0,0,0.05), 0 5px 15px rgba(255,255,255,0.4);
  }

  @keyframes fall {
    0% { transform: translateY(0) rotate(0deg); opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { transform: translateY(110vh) rotate(360deg); opacity: 0; }
  }
</style>
  </head>
  <body>
    <div class="container mt-5">
      <h1 class="mb-4 text-center">Rejalar</h1>

      <div class="p-4 shadow-sm bg-white" style="border-radius: 15px;">
        <form
          id="create-form"
          action="/create-item"
          method="POST"
          class="form-container"
        >
          <input
            id="create-field"
            name="reja"
            type="text"
            class="form-control mr-3"
            style="flex: 1"
            autocomplete="off"
            autofocus
            required
          />
          <button class="btn btn-primary">Yangi Reja qo'shish</button>
        </form>
      </div>

      <ul id="item-list" class="list-group mt-4 pb-5">
        <% items.map(function(item) { %>
          <li class="list-group-item list-group-item-info d-flex align-items-center justify-content-between mb-2 shadow-sm">
            <span class="item-text"><%= item.reja %></span>
            <div>
              <button
                data-id="<%= item._id %>"
                class="edit-me btn btn-secondary btn-sm mr-1"
              >
                O'zgartirish
              </button>
              <button 
                data-id="<%= item._id %>" 
                class="delete-me btn btn-danger btn-sm"
              >
                O'chirish
              </button>
            </div>
          </li>
        <% }) %>
      </ul>

      <div class="text-right">
        <button id="clean-all" class="btn btn-danger mt-3">
          Hamma Rejani o'chirish
        </button>
      </div>
    </div>
    <div class="pearl" style="left: 5%; width: 12px; height: 12px; animation-duration: 7s; animation-delay: 1s;"></div>
<div class="pearl" style="left: 15%; width: 22px; height: 22px; animation-duration: 12s; opacity: 0.6;"></div>
<div class="pearl" style="left: 40%; width: 15px; height: 15px; animation-duration: 9s; animation-delay: 3s;"></div>
<div class="pearl" style="left: 65%; width: 10px; height: 10px; animation-duration: 15s; animation-delay: 5s;"></div>
<div class="pearl" style="left: 80%; width: 18px; height: 18px; animation-duration: 10s; animation-delay: 2s;"></div>
<div class="pearl" style="left: 95%; width: 14px; height: 14px; animation-duration: 8s; animation-delay: 4s;"></div>
    <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
<script src="/browser.js"></script>
    </body>
</html>